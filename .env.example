# =====================================================================
# OdontoSis — variables de entorno (copiar a .env; NUNCA commitear .env)
# =====================================================================

# development | staging | production
APP_ENV=development

# ---- Base de datos (MySQL 8) ----
DB_HOST=
DB_PORT=3306
# odontosis_staging | odontosis_prod
DB_NAME=odontosis_staging
# Usuario de la APP: sólo permiso EXECUTE sobre la BD (todo acceso es vía stored procedures)
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10

# Usuario MIGRADOR (DDL + procedures). Sólo en local/CI, no en el servicio de la app.
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=

# ---- Seguridad ----
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY cifra datos sensibles (AES-256-GCM). Si se pierde, los datos cifrados son irrecuperables.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
SESSION_SECRET=
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- Archivos (logos) ----
# En Railway: volumen persistente montado en /data  ->  UPLOAD_DIR=/data/uploads
UPLOAD_DIR=./.data/uploads

# ---- Scripts (sólo local) ----
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# ---- Tests E2E (Playwright) ----
# E2E_BASE_URL=http://localhost:3100
# E2E_ADMIN_EMAIL=admin@demo.odontosis.pe
# DEMO_ADMIN_PASSWORD=
